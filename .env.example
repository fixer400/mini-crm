# Скопируйте в .env.local и заполните. .env.local не коммитится.

# --- Фронтенд: попадает в сборку, только публичные значения ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Только для локальных скриптов (npm run seed / npm run check:security) ---
# Без префикса VITE_, поэтому Vite никогда не встроит его в бандл.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Пароль тестовых пользователей для npm run seed / check:security
SEED_PASSWORD=choose-a-strong-password
